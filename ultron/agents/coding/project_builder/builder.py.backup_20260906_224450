from __future__ import annotations

import logging
import re
from dataclasses import dataclass, field
from typing import Any

from ultron.agents.coding.agent import CodingAgent
from ultron.agents.models import AgentTask
from ultron.improvement.validator.quality_checker import QualityChecker


logger = logging.getLogger(__name__)


@dataclass(frozen=True)
class ProjectFile:
    """A generated project file held entirely in memory."""

    path: str
    content: str
    language: str
    validation: dict[str, Any] = field(default_factory=dict)


@dataclass(frozen=True)
class ProjectBuildResult:
    """Complete result of a project-generation operation."""

    success: bool
    project_name: str
    description: str
    files: tuple[ProjectFile, ...] = ()
    errors: tuple[str, ...] = ()
    warnings: tuple[str, ...] = ()
    metadata: dict[str, Any] = field(default_factory=dict)

    @property
    def file_count(self) -> int:
        return len(self.files)


class ProjectBuilder:
    """
    Orchestrates deterministic multi-file software generation.

    The builder:

    1. validates the request
    2. determines the project language
    3. creates a controlled project manifest
    4. generates each file through the CodingAgent
    5. cleans generated source
    6. validates generated content
    7. returns an in-memory project artifact

    The builder never writes generated code to disk and never executes it.
    """

    DEFAULT_MAX_FILES = 20

    _LANGUAGE_EXTENSIONS = {
        "python": ".py",
        "javascript": ".js",
        "typescript": ".ts",
        "java": ".java",
        "kotlin": ".kt",
        "go": ".go",
        "rust": ".rs",
        "c": ".c",
        "cpp": ".cpp",
        "c++": ".cpp",
        "csharp": ".cs",
        "c#": ".cs",
    }

    _EMPTY_FILE_ALLOWLIST = {
        "python": {
            "__init__.py",
        },
    }

    def __init__(
        self,
        coding_agent: CodingAgent,
        quality_checker: QualityChecker | None = None,
        *,
        max_files: int = DEFAULT_MAX_FILES,
    ):
        if coding_agent is None:
            raise ValueError("coding_agent is required.")

        if max_files < 1:
            raise ValueError("max_files must be at least 1.")

        self.coding_agent = coding_agent
        self.quality_checker = (
            quality_checker
            if quality_checker is not None
            else QualityChecker()
        )
        self.max_files = max_files

    def build(
        self,
        request: str,
        *,
        project_name: str | None = None,
        project_root: str | None = None,
        preferred_languages: list[str] | None = None,
        context: dict[str, Any] | None = None,
    ) -> ProjectBuildResult:
        """
        Generate a complete project in memory.

        No filesystem mutation or generated-code execution occurs.
        """

        if not request or not request.strip():
            return ProjectBuildResult(
                success=False,
                project_name=project_name or "unnamed-project",
                description=request or "",
                errors=("Project request cannot be empty.",),
            )

        name = self._normalize_project_name(
            project_name or self._infer_project_name(request)
        )

        build_context = dict(context or {})

        try:
            language = self._select_language(
                request,
                project_root=project_root,
                preferred_languages=preferred_languages,
            )

            manifest = self._create_manifest(
                request,
                language=language,
                project_name=name,
            )

            files = self._generate_files(
                request,
                manifest,
                language=language,
                project_root=project_root,
                context=build_context,
            )

            if not files:
                return ProjectBuildResult(
                    success=False,
                    project_name=name,
                    description=request,
                    errors=("No project files were generated.",),
                    metadata={
                        "language": language,
                        "manifest": manifest,
                        "file_count": 0,
                    },
                )

            errors = tuple(
                f"{project_file.path}: validation failed"
                for project_file in files
                if not project_file.validation.get("passed", True)
            )

            warnings = tuple(
                f"{project_file.path}: "
                f"{issue}"
                for project_file in files
                for issue in project_file.validation.get(
                    "warnings",
                    [],
                )
            )

            return ProjectBuildResult(
                success=not errors,
                project_name=name,
                description=request,
                files=tuple(files),
                errors=errors,
                warnings=warnings,
                metadata={
                    "language": language,
                    "manifest": manifest,
                    "file_count": len(files),
                },
            )

        except Exception as exc:
            logger.exception("Project build failed.")

            return ProjectBuildResult(
                success=False,
                project_name=name,
                description=request,
                errors=(str(exc),),
                metadata={
                    "error": type(exc).__name__,
                    "file_count": 0,
                },
            )

    def _select_language(
        self,
        request: str,
        *,
        project_root: str | None,
        preferred_languages: list[str] | None,
    ) -> str:
        """
        Select a language through the agent when available.

        Lightweight test agents and alternative implementations may not
        expose LanguageSelector. In that case, use the preferred language
        or infer a sensible language from the request.
        """

        selector = getattr(
            self.coding_agent,
            "language_selector",
            None,
        )

        if selector is not None:
            selection = selector.select(
                request,
                project_root=project_root,
                preferred_languages=preferred_languages,
            )

            selected = getattr(
                selection,
                "selected",
                None,
            )

            if selected is not None:
                language = getattr(
                    selected,
                    "language",
                    None,
                )

                if language:
                    return str(language)

        if preferred_languages:
            for language in preferred_languages:
                if language and str(language).strip():
                    return str(language).strip()

        return self._infer_language(request)

    @staticmethod
    def _infer_language(request: str) -> str:
        text = request.lower()

        language_markers = (
            ("python", "Python"),
            ("typescript", "TypeScript"),
            ("javascript", "JavaScript"),
            ("java", "Java"),
            ("kotlin", "Kotlin"),
            ("rust", "Rust"),
            ("golang", "Go"),
            (" go ", "Go"),
            ("c++", "C++"),
            ("c#", "C#"),
        )

        padded = f" {text} "

        for marker, language in language_markers:
            if marker in text or marker in padded:
                return language

        return "Python"

    def _create_manifest(
        self,
        request: str,
        *,
        language: str,
        project_name: str,
    ) -> dict[str, Any]:
        """
        Create a deterministic initial project manifest.

        Paths are controlled by the builder rather than invented by the LLM.
        """

        language_lower = language.lower()

        if language_lower == "python":
            files = [
                "src/__init__.py",
                "src/main.py",
                "tests/test_main.py",
                "README.md",
            ]

        elif language_lower in {"javascript", "typescript"}:
            extension = (
                "ts"
                if language_lower == "typescript"
                else "js"
            )

            files = [
                f"src/index.{extension}",
                f"tests/index.test.{extension}",
                "README.md",
            ]

        elif language_lower == "java":
            files = [
                "src/main/Main.java",
                "src/test/MainTest.java",
                "README.md",
            ]

        elif language_lower == "go":
            files = [
                "main.go",
                "main_test.go",
                "README.md",
            ]

        elif language_lower == "rust":
            files = [
                "src/main.rs",
                "tests/main.rs",
                "README.md",
            ]

        else:
            extension = self._LANGUAGE_EXTENSIONS.get(
                language_lower,
                ".txt",
            )

            files = [
                f"src/main{extension}",
                "README.md",
            ]

        files = files[: self.max_files]

        return {
            "name": project_name,
            "language": language,
            "request": request,
            "files": files,
        }

    def _generate_files(
        self,
        request: str,
        manifest: dict[str, Any],
        *,
        language: str,
        project_root: str | None,
        context: dict[str, Any],
    ) -> list[ProjectFile]:
        generated: list[ProjectFile] = []

        for path in manifest["files"]:
            file_context = {
                **context,
                "project_root": project_root,
                "project_name": manifest["name"],
                "project_manifest": manifest,
                "target_file": path,
                "selected_language": language,
            }

            task = AgentTask(
                goal=(
                    f"Create the file '{path}' as part of the project "
                    f"described below.\n\n"
                    f"Project request:\n{request}"
                ),
                context=file_context,
            )

            try:
                result = self.coding_agent.execute(task)
            except Exception as exc:
                logger.exception(
                    "Generation raised an exception for %s.",
                    path,
                )

                generated.append(
                    ProjectFile(
                        path=path,
                        content="",
                        language=language,
                        validation={
                            "passed": False,
                            "score": 0,
                            "issues": [
                                f"Generation exception: {exc}",
                            ],
                        },
                    )
                )
                continue

            if not result.success:
                logger.warning(
                    "Generation failed for %s: %s",
                    path,
                    result.output,
                )

                generated.append(
                    ProjectFile(
                        path=path,
                        content="",
                        language=language,
                        validation={
                            "passed": False,
                            "score": 0,
                            "issues": [
                                result.output,
                            ],
                        },
                    )
                )
                continue

            content = self._clean_generated_content(
                result.output
            )

            validation = self._validate_file(
                content,
                language,
                path=path,
            )

            generated.append(
                ProjectFile(
                    path=path,
                    content=content,
                    language=language,
                    validation=validation,
                )
            )

        return generated

    def _validate_file(
        self,
        content: str,
        language: str,
        *,
        path: str | None = None,
    ) -> dict[str, Any]:
        """
        Validate generated content through QualityChecker.

        Empty structural files such as Python __init__.py are valid.
        """

        if not content.strip():
            filename = (
                path.rsplit("/", 1)[-1]
                if path
                else ""
            )

            if filename in self._EMPTY_FILE_ALLOWLIST.get(
                language.lower(),
                set(),
            ):
                return {
                    "passed": True,
                    "score": 1,
                    "issues": [],
                    "warnings": [
                        "Empty structural file accepted.",
                    ],
                }

            return {
                "passed": False,
                "score": 0,
                "issues": ["Generated code is empty"],
                "warnings": [],
            }

        try:
            return self.quality_checker.check_code(
                content,
                language=language,
            )

        except AttributeError:
            return {
                "passed": True,
                "score": 1,
                "issues": [],
                "warnings": [
                    "QualityChecker does not expose check_code().",
                ],
            }

    @staticmethod
    def _clean_generated_content(content: str) -> str:
        """
        Remove accidental surrounding Markdown fences.

        Preserve the source's meaningful trailing newline.
        """

        if content is None:
            return ""

        text = str(content).strip()

        match = re.fullmatch(
            r"```[A-Za-z0-9_+#.-]*\s*\n?(.*?)\n?\s*```",
            text,
            flags=re.DOTALL,
        )

        if match:
            cleaned = match.group(1).strip()
        else:
            cleaned = text

        if not cleaned:
            return ""

        return cleaned + "\n"

    @staticmethod
    def _infer_project_name(request: str) -> str:
        words = re.findall(
            r"[A-Za-z0-9]+",
            request,
        )

        if not words:
            return "ultron-project"

        stop_words = {
            "create",
            "build",
            "make",
            "develop",
            "a",
            "an",
            "the",
            "application",
            "app",
            "project",
            "tool",
            "using",
        }

        useful = [
            word
            for word in words
            if word.lower() not in stop_words
        ]

        if not useful:
            return "ultron-project"

        return "-".join(
            word.lower()
            for word in useful[:4]
        )

    @staticmethod
    def _normalize_project_name(name: str) -> str:
        normalized = re.sub(
            r"[^A-Za-z0-9._-]+",
            "-",
            name.strip().lower(),
        )

        normalized = normalized.strip(".-_")

        return normalized or "ultron-project"
