{
  "voice_engine": {
    "primary": "xtts",
    "fallback": "edge",
    "model_spec": "coqui/XTTS-v2",
    "device": "cpu",
    "torch_threads": 4,
    "max_ram_gb_hint": 7.7,
    "low_ram_mode": true,
    "reference_audio": "voice/assets/reference/ultron_reference.wav",
    "clone_condition_length_s": 30.0,
    "ffmpeg_dll_dir": "voice/third_party/ffmpeg/bin"
  },

  "edge_engine": {
    "voice": "en-US-ChristopherNeural",
    "rate_note": "fallback base voice; shaped toward the measured profile by the DSP stage",
    "clearly_not_a_clone": true
  },

  "sample_rate": 24000,
  "output_format": "wav",

  "text_normalization": {
    "expand_braces": true,
    "strip_markdown": true,
    "remove_block_labels": [
      "CORE",
      "NAV",
      "ALERT",
      "EXEC",
      "AUDIT"
    ],
    "collapse_whitespace": true
  },

  "delivery": {
    "base_tempo": 0.92,
    "styles": {
      "normal":        { "rate": 1.0, "pitch_target_hz": 92.0, "pitch_range": 30.0, "energy": 1.0,  "emphases": ["deliberate"] },
      "information":   { "rate": 1.0, "pitch_target_hz": 96.0, "pitch_range": 28.0, "energy": 1.0,  "emphases": ["precise", "neutral"] },
      "warning":       { "rate": 0.85, "pitch_target_hz": 88.0, "pitch_range": 24.0, "energy": 1.15, "emphases": ["firmer", "slower", "intense"] },
      "critical":      { "rate": 0.8, "pitch_target_hz": 86.0, "pitch_range": 35.0, "energy": 1.3,  "emphases": ["strong", "controlled"] },
      "confirmation":  { "rate": 1.05, "pitch_target_hz": 90.0, "pitch_range": 20.0, "energy": 1.05, "emphases": ["brief", "authoritative"] },
      "question":      { "rate": 0.95, "pitch_target_hz": 98.0, "pitch_range": 40.0, "energy": 1.0,  "emphases": ["restrained", "rising_ending"] },
      "error":         { "rate": 0.92, "pitch_target_hz": 90.0, "pitch_range": 26.0, "energy": 1.1,  "emphases": ["clear", "unemotional"] }
    }
  },

  "processing": {
    "enabled": true,
    "hard_highpass_hz": 65.0,
    "soft_highpass_hz": 90.0,
    "low_shelf": { "freq_hz": 250.0, "gain_db": 2.5 },
    "presence_peak": { "freq_hz": 950.0, "gain_db": 1.0, "q": 0.8 },
    "de_emphasis_high": { "freq_hz": 2600.0, "gain_db": -1.5 },
    "de_ess": { "threshold_db": -24.0, "ratio": 0.5, "band_start_hz": 5000.0 },
    "compressor": { "threshold_db": -22.0, "ratio": 2.5, "attack_ms": 8.0, "release_ms": 120.0 },
    "saturation": { "driver_db": 6.0, "blend": 0.18 },
    "resonance": { "formant_boosts_hz": [160.0, 900.0], "boosts_db": [2.0, 1.2] },
    "noise_gate": { "threshold_db": -50.0, "attack_ms": 2.0, "release_ms": 100.0 },
    "limiter": { "ceiling_db": -1.0, "release_ms": 60.0 },
    "loudness": { "target_lufs": -22.5, "tolerance_db": 1.5 },
    "style_spectral": {
      "enabled": true,
      "min_energy": 1.1,
      "low_shelf_trim_db": 1.0,
      "presence_boost_db": 1.5
    }
  },

  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "base_path": "/api/v1",
    "max_request_chars": 2000,
    "preload_model_on_start": true
  },

  "capability_label": "ULTRON VOICE — SYNTHESIS SERVICE (profile-derived processing; XTTS primary clone; edge fallback is explicitly NOT a clone of the reference speaker)"
}