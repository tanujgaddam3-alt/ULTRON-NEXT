class FinancialAgent:
    """
    Coordinates the complete financial intelligence pipeline.
    """

    def __init__(
        self,
        market_data,
        analysis,
        regime,
        reasoning,
        decision,
        memory,
    ):
        self.market_data = market_data
        self.analysis = analysis
        self.regime = regime
        self.reasoning = reasoning
        self.decision = decision
        self.memory = memory

    def analyze(self, symbol):
        # -------------------------------------------------
        # 1. Company data
        # -------------------------------------------------
        company = self.market_data.execute(
            {
                "action": "company",
                "symbol": symbol,
            }
        )

        if not company.get("success"):
            return {
                "success": False,
                "symbol": symbol,
                "stage": "company",
                "error": company,
            }

        # -------------------------------------------------
        # 2. Market analysis
        # -------------------------------------------------
        market = self.market_data.execute(
            {
                "action": "analyze",
                "symbol": symbol,
            }
        )

        if not market.get("success", True):
            return {
                "success": False,
                "symbol": symbol,
                "stage": "market",
                "error": market,
            }

        # -------------------------------------------------
        # 3. Financial analysis
        # -------------------------------------------------
        financial_analysis = self.analysis.execute(
            {
                "symbol": symbol,
            }
        )

        if not financial_analysis.get("success"):
            return {
                "success": False,
                "symbol": symbol,
                "stage": "financial_analysis",
                "error": financial_analysis,
            }

        # -------------------------------------------------
        # 4. Raw historical data
        # -------------------------------------------------
        history = self.market_data.provider.get_history(
            symbol,
            period="1y",
        )

        if history is None or history.empty:
            return {
                "success": False,
                "symbol": symbol,
                "stage": "history",
                "error": "No historical market data available",
            }

        # -------------------------------------------------
        # 5. Market regime
        # -------------------------------------------------
        regime = self.regime.analyze(history)

        # -------------------------------------------------
        # 6. Memory-aware financial reasoning
        # -------------------------------------------------
        reasoning = self.reasoning.analyze(
            symbol,
            financial_analysis,
        )

        # -------------------------------------------------
        # 7. Strategy
        # -------------------------------------------------
        strategy = None

        # -------------------------------------------------
        # 8. Financial decision
        # -------------------------------------------------
        decision = self.decision.decide(
            reasoning,
            regime["regime"],
            strategy,
        )

        # -------------------------------------------------
        # 9. Store experience
        # -------------------------------------------------
        try:
            self.memory.store.save(
                symbol=symbol,
                analysis=financial_analysis,
                reasoning=reasoning,
                decision=decision,
            )
        except (AttributeError, TypeError):
            pass

        # -------------------------------------------------
        # 10. Unified report
        # -------------------------------------------------
        return {
            "success": True,
            "symbol": symbol,
            "company": company,
            "market": market,
            "financial_analysis": financial_analysis,
            "regime": regime,
            "reasoning": reasoning,
            "decision": decision,
        }
