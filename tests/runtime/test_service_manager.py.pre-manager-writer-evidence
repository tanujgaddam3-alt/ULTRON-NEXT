    def test_control_channel_startup_failure_rolls_back_only_started_children(self):
        external_port = free_port()
        external = fixture_service(
            self.root, "external", external_port, marker="external-control-fixture"
        )
        external_process = subprocess.Popen(
            external.command,
            cwd=self.root,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        try:
            deadline = time.monotonic() + 2
            while external.probe() is None and time.monotonic() < deadline:
                time.sleep(0.02)
            for count in (1, 3):
                with self.subTest(started_services=count):
                    services = [
                        fixture_service(
                            self.root,
                            f"service-{index}",
                            free_port(),
                            marker=f"control-fixture-{index}",
                        )
                        for index in range(count)
                    ]
                    state = self.state / str(count)
                    manager = ServiceManager(
                        self.root,
                        state_directory=state,
                        services=services,
                        readiness_timeout=2,
                        poll_interval=0.02,
                        validate_project=False,
                    )
                    manager.acquire_manager_lease()
                    try:
                        with patch.object(
                            manager,
                            "start_control_channel",
                            side_effect=StartupFailure(
                                "manager", "injected control socket failure", {}
                            ),
                        ):
                            with self.assertRaisesRegex(
                                StartupFailure, "injected control socket failure"
                            ) as raised:
                                manager.start_with_control_channel()
                        self.assertIn("All manager-started services were stopped", str(raised.exception))
                        state_record = json.loads(
                            (state / "services.json").read_text()
                        )
                        self.assertEqual(state_record["services"], {})
                        recovery = state_record["startupRecovery"]
                        self.assertEqual(recovery["status"], "ROLLED_BACK")
                        self.assertEqual(
                            recovery["failureReason"], "injected control socket failure"
                        )
                        self.assertEqual(
                            list(recovery["outcomes"]),
                            [service.name for service in reversed(services)],
                        )
                        self.assertEqual(manager.owned_processes(), {})
                        self.assertIsNone(external_process.poll())

                        competitor = ServiceManager(
                            self.root,
                            state_directory=state,
                            services=services,
                            validate_project=False,
                        )
                        with self.assertRaisesRegex(
                            StartupFailure, "Another service manager"
                        ):
                            competitor.acquire_manager_lease()
                        manager.release_manager_lease()
                        competitor.acquire_manager_lease()
                        competitor.release_manager_lease()
                    finally:
                        manager.close_control_channel()
                        manager.release_manager_lease()
        finally:
            external_process.terminate()
            external_process.wait(timeout=3)

