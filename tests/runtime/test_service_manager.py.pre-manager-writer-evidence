        self.assertTrue(replay["success"])
        self.assertEqual(replay["writersStatus"], "OPERATOR_ATTESTED")
        self.assertEqual(replay["writerAttestationSource"], "OPERATOR")

        state = json.loads((self.state / "services.json").read_text())
