    def test_control_rollback_never_signals_ambiguous_child_and_blocks_next_owner(self):
        port = free_port()
        service = fixture_service(self.root, "fixture", port)
        manager = self.manager([service])
        manager.acquire_manager_lease()
        child_pid = None
        try:
            real_stop = manager._stop_record

            def reject_identity(candidate, record):
                with patch.object(manager, "_process_matches", return_value=False):
                    return real_stop(candidate, record)

            with patch.object(
                manager,
                "start_control_channel",
                side_effect=StartupFailure("manager", "injected socket failure", {}),
            ), patch.object(manager, "_stop_record", side_effect=reject_identity):
                with self.assertRaisesRegex(
                    StartupFailure, "OPERATOR_INTERVENTION_REQUIRED"
                ) as raised:
                    manager.start_with_control_channel()
            child_pid = manager.owned_processes()["fixture"]
            child = manager._processes["fixture"]
            self.assertIsNone(child.poll())
            self.assertIn("injected socket failure", str(raised.exception))
            persisted = json.loads((self.state / "services.json").read_text())
            self.assertEqual(
                persisted["startupRecovery"]["status"],
                "OPERATOR_INTERVENTION_REQUIRED",
            )
            self.assertEqual(persisted["services"]["fixture"]["pid"], child_pid)

            manager.release_manager_lease()
            competitor = self.manager([service])
            with self.assertRaisesRegex(
                StartupFailure, "operator intervention"
            ):
                competitor.acquire_manager_lease()
            child.terminate()
            child.wait(timeout=3)
        finally:
            if manager._manager_lease_descriptor is not None:
                manager.release_manager_lease()

    def test_control_rollback_clears_record_when_child_exits_during_cleanup(self):
        port = free_port()
        service = fixture_service(self.root, "fixture", port)
        manager = self.manager([service])
        manager.acquire_manager_lease()
        try:
            real_stop = manager._stop_record

            def exit_child_before_identity_check(candidate, record):
                child = manager._processes[candidate.name]
                child.terminate()
                child.wait(timeout=2)
                return real_stop(candidate, record)

            with patch.object(
                manager,
                "start_control_channel",
                side_effect=StartupFailure("manager", "original control failure", {}),
            ), patch.object(
                manager, "_stop_record", side_effect=exit_child_before_identity_check
            ):
                with self.assertRaisesRegex(
                    StartupFailure, "All manager-started services were stopped"
                ):
                    manager.start_with_control_channel()
            persisted = json.loads((self.state / "services.json").read_text())
            self.assertEqual(persisted["services"], {})
            self.assertEqual(persisted["startupRecovery"]["status"], "ROLLED_BACK")
            self.assertEqual(manager.owned_processes(), {})
        finally:
            manager.release_manager_lease()

