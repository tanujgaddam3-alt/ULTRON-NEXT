                        "import signal,socket,sys,time; "
                        "signal.signal(signal.SIGINT, signal.SIG_IGN); "
                        "signal.signal(signal.SIGTERM, signal.SIG_IGN); "
                        "s=socket.socket(); s.bind(('127.0.0.1',int(sys.argv[1]))); "
                        "s.listen(); print(sys.argv[2],flush=True); time.sleep(60)",
                        str(port),
                        marker,
                    )
                service = fixture_service(
                    self.root,
                    "fixture",
                    port,
                    marker=marker,
                    command=command,
                )
                state = self.state / failure_kind
                manager = ServiceManager(
                    self.root,
                    state_directory=state,
                    services=[service],
                    readiness_timeout=2,
                    poll_interval=0.02,
                    validate_project=False,
                )
                manager.acquire_manager_lease()
                child = None
                try:
                    real_write = manager._write_state
                    real_stop = manager._stop_record
                    writes_during_rollback = 0
                    rollback_started = False

                    def fail_first_rollback_write(state_value):
                        nonlocal writes_during_rollback, rollback_started
                        if not rollback_started:
                            return real_write(state_value)
                        writes_during_rollback += 1
                        if failure_kind == "state-write" and writes_during_rollback == 1:
                            raise OSError("injected state persistence failure")
                        return real_write(state_value)

                    def fail_control_channel():
                        nonlocal rollback_started
                        rollback_started = True
                        raise StartupFailure("manager", "original socket error", {})

                    def fail_shutdown(candidate, record):
                        child_process = manager._processes[candidate.name]
                        child_process.terminate()
                        child_process.wait(timeout=2)
                        return real_stop(candidate, record)

                    with patch.object(
                        manager,
                        "start_control_channel",
                        side_effect=fail_control_channel,
                    ):
                        if failure_kind == "shutdown":
                            real_kill = service_manager_module.os.kill

                            def suppress_kill(pid, requested_signal):
                                managed = manager._processes.get("fixture")
                                if (
                                    managed is not None
                                    and pid == managed.pid
                                    and requested_signal == signal.SIGKILL
                                ):
                                    return None
                                return real_kill(pid, requested_signal)

                            with patch.object(
                                service_manager_module,
                                "SERVICE_SHUTDOWN_STEPS",
                                ((signal.SIGINT, 0.05), (signal.SIGTERM, 0.05)),
                            ), patch.object(
                                service_manager_module,
                                "SERVICE_KILL_WAIT",
                                0.05,
                            ), patch.object(
                                service_manager_module.os,
                                "kill",
                                side_effect=suppress_kill,
                            ):
                                start_time = time.monotonic()
                                with self.assertRaisesRegex(
                                    StartupFailure, "original socket error"
                                ) as raised:
                                    manager.start_with_control_channel()
                                self.assertLess(time.monotonic() - start_time, 1)
                        else:
                            with patch.object(
                                manager, "_stop_record", side_effect=fail_shutdown
                            ), patch.object(
                                manager, "_write_state", side_effect=fail_first_rollback_write
                            ):
                                with self.assertRaisesRegex(
                                    StartupFailure, "original socket error"
                                ) as raised:
                                    manager.start_with_control_channel()
                    state_value = json.loads((state / "services.json").read_text())
                    self.assertEqual(
                        state_value["startupRecovery"]["status"],
                        "OPERATOR_INTERVENTION_REQUIRED",
                    )
                    self.assertEqual(
                        state_value["startupRecovery"]["failureReason"],
                        "original socket error",
                    )
                    self.assertIn(
                        "OPERATOR_INTERVENTION_REQUIRED", str(raised.exception)
                    )
                    child = manager._processes.get("fixture")
                    if failure_kind == "shutdown":
                        self.assertIsNotNone(child)
                        self.assertIsNone(child.poll())
                        self.assertEqual(len(state_value["services"]), 1)
                    else:
                        self.assertIsNotNone(child)
                        self.assertIsNotNone(child.poll())
                        self.assertEqual(len(state_value["services"]), 1)
                        self.assertEqual(
                            state_value["startupRecovery"]["statePersistenceError"],
                            "OSError",
                        )
                finally:
                    if child is not None and child.poll() is None:
                        child.kill()
                        child.wait(timeout=3)
                    manager.release_manager_lease()

    def test_manager_lease_release_failure_keeps_exclusive_lock_until_retried(self):
        manager = self.manager([])
        competitor = self.manager([])
        manager.acquire_manager_lease()
        descriptor = manager._manager_lease_descriptor
        real_flock = service_manager_module.fcntl.flock

        def fail_unlock(fd, operation):
            if fd == descriptor and operation == service_manager_module.fcntl.LOCK_UN:
                raise OSError("injected lease release failure")
            return real_flock(fd, operation)

        try:
            with patch.object(service_manager_module.fcntl, "flock", side_effect=fail_unlock):
                with self.assertRaisesRegex(OSError, "injected lease release failure"):
                    manager.release_manager_lease()
            with self.assertRaisesRegex(StartupFailure, "Another service manager"):
                competitor.acquire_manager_lease()
            manager.release_manager_lease()
            competitor.acquire_manager_lease()
            competitor.release_manager_lease()
        finally:
            manager.release_manager_lease()
            competitor.release_manager_lease()

