def free_port() -> int:
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        return listener.getsockname()[1]


def operator_writer_attestation(quiesce_operation_id: str) -> dict:
    return {
        "quiesceOperationId": quiesce_operation_id,
        "operator": "cre-maintenance-operator",
        "attestedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "writerInventory": ["ultron.gateway", "ultron.external.fixture"],
        "restartSourceInventory": ["ultron.gateway.service", "ultron.writer.timer"],
        "evidenceReferences": ["maintenance/20261102/writer-snapshot.json"],
        "allWritersStopped": True,
        "allRestartSourcesHeld": True,
        "inventoryCompletenessChecked": True,
    }


def service_command(port: int, marker: str, output: str = "") -> tuple[str, ...]:
    code = (
        "import socket,sys,time; "
        f"print({output!r}, flush=True); "
        "s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1); "
        "s.bind(('127.0.0.1',int(sys.argv[1]))); s.listen(); "
        f"print({marker!r}, flush=True); "
        "exec('while True:\\n c,a=s.accept()\\n c.close()')"
    )
    return (PYTHON, "-u", "-c", code, str(port))


def fixture_service(
    root: Path,
    name: str,
    port: int,
    *,
    marker: str = "expected-fixture",
    probe=None,
    command: tuple[str, ...] | None = None,
) -> Service:
    def healthy():
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.2):
                return f"fixture-ready-{name}"
        except OSError:
            return None

    return Service(
        name=name,
        host="127.0.0.1",
        port=port,
        command=command or service_command(port, marker),
        cwd=root,
        probe=probe or healthy,
        identity=lambda arguments: any(marker in argument for argument in arguments),
    )


class ServiceManagerTests(unittest.TestCase):
    def setUp(self) -> None:
        self.temporary = tempfile.TemporaryDirectory()
        self.root = Path(self.temporary.name)
        self.state = self.root / "state"
        self.managers = []

    def tearDown(self) -> None:
        for manager in self.managers:
            manager.release_manager_lease()
        self.temporary.cleanup()

    def operator_attest(self, manager, quiesce_id, *, operation_id="writer-attestation"):
        return manager._attest_gateway_writers(
            operation_id,
            operator_writer_attestation(quiesce_id),
        )

    def write_quiesced_state(self, quiesce_id: str) -> None:
        self.state.mkdir(mode=0o700, parents=True, exist_ok=True)
        state = {
            "version": 1,
            "services": {},
            "gatewayQuiesce": {
                "status": "QUIESCED",
                "operationId": quiesce_id,
                "gatewayStatus": "STOPPED",
                "process": {"pid": 2_000_000_000, "start_ticks": 1},
                "writersStatus": "NOT_VERIFIED",
            },
        }
        self.state.joinpath("services.json").write_text(json.dumps(state), encoding="utf-8")
        self.state.joinpath("services.json").chmod(0o600)

    def manager(self, services, *, timeout=2.0, secrets=()):
        manager = ServiceManager(
            self.root,
            state_directory=self.state,
            services=services,
            readiness_timeout=timeout,
            poll_interval=0.05,
            extra_secrets=secrets,
            validate_project=False,
        )
        self.managers.append(manager)
        return manager

    def recovery_manager(self, *, port=None, hold_lease=True):
        gateway = fixture_service(
            self.root,
            "gateway",
            port or free_port(),
            marker="gateway-quiescence-recovery",
        )
        manager = self.manager([gateway])
        if hold_lease:
            manager.acquire_manager_lease()
        return manager

    def test_gateway_lifecycle_rejects_illegal_transitions_and_is_idempotent(self):
        manager = self.manager([])
        state = {"version": 1, "services": {}}

        manager._transition_gateway_lifecycle(
            state, "STARTING", "isolated startup", operation_id="offline-start"
        )
        manager._transition_gateway_lifecycle(
            state, "RUNNING", "isolated readiness verified", operation_id="offline-start"
        )
        history_before = list(state["gatewayLifecycle"]["history"])
        manager._transition_gateway_lifecycle(
            state, "RUNNING", "repeat observation", operation_id="offline-start"
        )

        self.assertEqual(state["gatewayLifecycle"]["state"], "RUNNING")
        self.assertEqual(state["gatewayLifecycle"]["history"], history_before)
        with self.assertRaisesRegex(StartupFailure, "Illegal gateway lifecycle transition"):
            manager._transition_gateway_lifecycle(
                state, "RECOVERING", "recovery without quiescence"
            )

