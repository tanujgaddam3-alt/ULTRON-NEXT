                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            deadline = time.monotonic() + 2
            while auth.probe() is None and time.monotonic() < deadline:
                time.sleep(0.02)
            candidate_record = manager._record_for(auth, candidate.pid)
            candidate_record["start_ticks"] += 1
            manager._write_state({
                "version": 1,
                "services": {},
                "activeControlOperation": "ambiguous-candidate",
                "controlOperations": {
                    "ambiguous-candidate": {
                        "operation": "restart-auth",
                        "service": "auth",
                        "status": "VERIFYING",
                        "createdAt": time.time(),
                        "updatedAt": time.time(),
                        "candidateProcess": candidate_record,
                        "events": [],
                    },
                },
            })

            with self.assertRaisesRegex(StartupFailure, "ambiguous"):
                manager.start_all()
            self.assertIsNone(candidate.poll())
        finally:
            if candidate is not None and candidate.poll() is None:
                candidate.terminate()
                candidate.wait(timeout=2)
            manager.release_manager_lease()

if __name__ == "__main__":
    unittest.main()
